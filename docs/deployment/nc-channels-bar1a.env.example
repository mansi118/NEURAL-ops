# /home/ubuntu/nc-channels-bar1a.env — env-file for the durable bridge container (chmod 600, root-owned).
# The bridge is a Docker container (nc-channels-bar1a, python:3.12-slim, restart=unless-stopped) on the
# matrix box. Recreate it with --env-file pointing here. DO NOT commit the filled copy (tokens).

# ── the durable wire: STABLE Cloud Map name, not the wrapper's dynamic task IP ──
# Resolvable only after (1) the Route53 zone->matrix-VPC association (peering.tf) AND
# (2) the systemd-resolved drop-in (resolved-neos-cloudmap.conf) are both in place.
SEAT_URL=http://seat-wrapper.neos-dogfood.local:8090/seat/turn

# bridge->seat shared secret — MUST byte-match the wrapper's WRAPPER_FORWARD_TOKEN (Secrets Manager).
FORWARD_TOKEN=

# ── Matrix Application Service registration (unchanged from Bar-1a/Bar-2) ──
HS_BASE_URL=https://matrix.neuraledge.in
AS_TOKEN=
HS_TOKEN=
AS_URL=http://nc-channels-bar1a:8010
AS_USER_REGEX=@neop_.*:neuraledge\.in
AS_SENDER=neos-bot
AS_SERVER_NAME=neuraledge.in
AS_TENANT=neuraledge

# bridge listen socket (Synapse reaches it via AS_URL on the matrix-homeserver docker network)
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8010
